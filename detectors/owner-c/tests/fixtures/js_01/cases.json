[
  {
    "id": "JS-01-01",
    "title": "known positive: serial awaits in a loop confirmed by back-to-back X-Ray calls of the same service",
    "files": {
      "app.js": "async function load(ids) {\n  const out = [];\n  for (const id of ids) {\n    out.push(await inventory.get(id));\n  }\n  return out;\n}\n"
    },
    "expect": {
      "status": "completed",
      "findings": [
        {
          "identity": "load:await:inventory.get",
          "line": 4,
          "confidence": "medium"
        }
      ]
    },
    "artifacts": {
      "xray": {
        "app.js": {
          "profiler": "xray",
          "function": "orders-fn",
          "traces_analyzed": 3,
          "max_serial_calls": 8,
          "serial_wall_seconds": 0.9,
          "serial_services": [
            "Inventory"
          ]
        }
      }
    }
  },
