{
  "family": "orders",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "example/orders-api:1.0",
      "memoryReservation": 256,
      "essential": true
    },
    {
      "name": "log-router",
      "image": "example/fluent-bit:2.2",
      "memory": 128,
      "cpu": 0,
      "essential": false
    },
    {
      "name": "metrics",
      "image": "example/metrics:1.0",
      "memory": 64,
      "cpu": 64
    }
  ]
}
