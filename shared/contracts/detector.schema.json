{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detector contract v1",
  "oneOf": [{"$ref": "#/$defs/input"}, {"$ref": "#/$defs/result"}],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "base": {
      "type": "object",
      "required": ["schema_version", "kind", "repository_id", "scan_id", "commit_sha", "check_id", "detector_version", "context", "scope"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"enum": ["input", "result"]},
        "repository_id": {"$ref": "#/$defs/text"},
        "scan_id": {"$ref": "#/$defs/text"},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
        "check_id": {"$ref": "#/$defs/text"},
        "detector_version": {"$ref": "#/$defs/text"},
        "context": {
          "type": "object",
          "description": "All evaluation-affecting settings, including environment, thresholds and model/prompt versions. Never credentials."
        },
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "scope_id", "kind", "locator"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"},
        "scope_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["static", "telemetry", "artifact"]},
        "locator": {"$ref": "#/$defs/text"},
        "content": {"type": "string"},
        "data": {"type": "object"}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "static"}}},
        "then": {"required": ["content"], "not": {"required": ["data"]}},
        "else": {"required": ["data"], "not": {"required": ["content"]}}
      }]
    },
    "input": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "unevaluatedProperties": false,
      "required": ["sources"],
      "properties": {
        "kind": {"const": "input"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "locator", "value"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["static", "telemetry", "artifact"]},
        "locator": {"$ref": "#/$defs/text"},
        "value": {},
        "line_start": {"type": "integer", "minimum": 1},
        "field": {"$ref": "#/$defs/text"}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "static"}}},
        "then": {
          "required": ["line_start"],
          "properties": {"value": {"$ref": "#/$defs/text"}},
          "not": {"required": ["field"]}
        },
        "else": {"required": ["field"], "not": {"required": ["line_start"]}}
      }]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "scope_id", "identity", "summary", "confidence", "recommendation", "references", "evidence"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope_id": {"$ref": "#/$defs/text"},
        "identity": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "recommendation": {"$ref": "#/$defs/text"},
        "references": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https?://[^/\\s]+(/.*)?$"}
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "basis", "boundary", "allocation_key", "window", "provenance"],
      "properties": {
        "metric": {"enum": ["energy", "emissions", "cpu_time", "data_transfer", "requests", "tokens", "log_volume"]},
        "value": {"type": "number", "minimum": 0},
        "unit": {"enum": ["kWh", "kgCO2e", "seconds", "bytes", "count"]},
        "basis": {"enum": ["measured", "user_provided", "modelled"]},
        "boundary": {"$ref": "#/$defs/text"},
        "allocation_key": {"$ref": "#/$defs/text"},
        "window": {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source_ids", "method", "assumptions"],
          "properties": {
            "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
            "method": {"$ref": "#/$defs/text"},
            "assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },
    "result": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "unevaluatedProperties": false,
      "required": ["status", "coverage", "findings", "measurements"],
      "properties": {
        "kind": {"const": "result"},
        "status": {"enum": ["completed", "partial", "unavailable", "error"]},
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["evaluated_scope", "limitations"],
          "properties": {
            "evaluated_scope": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
            "limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}}
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}}
      }
    }
  }
}
