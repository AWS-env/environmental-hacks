# Copy to .env.local for `npm run dev`. NEXT_PUBLIC_* values are inlined at build time.
# scan-api base URL: infra/scan-api stack output ScanApiUrl. Unset: Analyze shows "not configured".
NEXT_PUBLIC_SCAN_API_URL=https://<scan-api-id>.execute-api.ap-south-1.amazonaws.com
# findings-hub read API base URL: owner-d-hub-api stack output HubApiUrl. Unset: report-only results.
NEXT_PUBLIC_HUB_API_URL=https://<hub-api-id>.execute-api.ap-south-1.amazonaws.com
